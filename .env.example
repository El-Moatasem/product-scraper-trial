MYSQL_DATABASE=product_scraper
MYSQL_USER=scraper
MYSQL_PASSWORD=scraper_secret
MYSQL_ROOT_PASSWORD=root_secret

# Optional comma-separated proxy URLs. Leave empty to use a direct connection.
# Example: http://user:password@proxy-one.example:8080,http://proxy-two.example:8080
PROXY_URLS=
PROXY_MANAGER_TOKEN=
PROXY_FAILURE_THRESHOLD=3
PROXY_COOLDOWN=60s

NEXT_PUBLIC_API_URL=http://localhost:8000/api
